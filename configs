{
  "mcpServers": {
    "workspace-root": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/Diego/workspace"
      ],
      "env": {
        "ALLOWED_PATHS": "/Users/Diego/workspace",
        "BLOCKED_PATHS": "/Users/Diego/workspace/secrets, /Users/Diego/workspace/*.env"
      }
    },
    "global-git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "/Users/Diego/workspace"
      ]
    }
  }
}
