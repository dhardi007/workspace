---
import IconGithub from "./icons/IconGithub.astro";
import IconLinkedin from "./icons/IconLinkedin.astro";
import IconGmail from "./icons/IconGmail.astro";
---

<footer class="border-t" style="border-color: var(--border-color);">
  <div class="mx-auto max-w-5xl px-4 py-8">
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <p class="text-sm" style="color: var(--text-muted);">
        &copy; {new Date().getFullYear()} Diego Härdi
      </p>
      <div class="flex items-center gap-4">
        <a href="https://github.com/dizzi1222" target="_blank" class="transition-opacity hover:opacity-70" style="color: var(--text-muted);" aria-label="GitHub">
          <IconGithub size={18} />
        </a>
        <a href="https://www.linkedin.com/in/dizzi-%C5%8Dkami-0b77093a1/" target="_blank" class="transition-opacity hover:opacity-70" style="color: var(--text-muted);" aria-label="LinkedIn">
          <IconLinkedin size={18} />
        </a>
        <a href="mailto:diegosamuel042@gmail.com" class="transition-opacity hover:opacity-70" style="color: var(--text-muted);" aria-label="Gmail">
          <IconGmail size={18} />
        </a>
      </div>
      <a href="https://portfolio-terminal-dhardi.vercel.app" target="_blank" class="text-xs transition-all hover:opacity-70" style="color: var(--text-muted);">
        <span data-i18n="footer.terminal">Versión Terminal</span> <span style="color: var(--color-cyan);">🖥️</span>
      </a>
    </div>
  </div>
</footer>
