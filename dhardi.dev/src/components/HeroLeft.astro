---
import TypingAnimationWrapper from "./TypingAnimationWrapper";

const { class: className = "" } = Astro.props;
---

<div class={className}>
  <div class="mb-2 inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs" style="background: rgba(0,217,255,0.1); color: var(--color-cyan); border: 1px solid rgba(0,217,255,0.2);">
    <span class="inline-block h-2 w-2 rounded-full" style="background: #33c08c; animation: blink 1s step-end infinite;"></span>
    Disponible para oportunidades
  </div>
  <h1 class="text-4xl font-extrabold leading-tight sm:text-5xl">
    Diego <span style="background: linear-gradient(135deg, var(--color-brand), var(--color-cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Härdi</span>
  </h1>
  <p class="mt-2 text-lg" style="color: var(--text-muted);">
    DevOps &amp; Software Engineer
  </p>
  <p class="text-sm" style="color: var(--text-muted);">
    <span style="color: var(--text-muted);">🇨🇭 Suizo viviendo en</span> <span style="color: var(--text-muted);">🇩🇴 Jarabacoa, RD</span>
  </p>

  <TypingAnimationWrapper
    text=">_ TypeScript · React · Node.js · Arch Linux · Neovim"
    class="mt-4 text-sm" client:load
  />

  <div class="mt-6 flex flex-wrap gap-3">
    <a href="/cv.pdf" target="_blank" class="inline-flex items-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold transition-all hover:opacity-85" style="background: var(--color-brand); color: #fff;">
      Descargar CV
    </a>
    <a href="#contact" class="inline-flex items-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold transition-all hover:opacity-85" style="background: transparent; color: var(--text-primary); border: 2px solid var(--border-color);">
      Contáctame
    </a>
  </div>
</div>
