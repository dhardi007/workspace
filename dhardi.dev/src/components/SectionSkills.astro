---
import { skills } from "../lib/skills.ts";
import Skill from "./Skill.astro";
import BlurFadeW from "./ui/BlurFadeW";
---

<section id="skills" class="mx-auto max-w-5xl px-4 py-20">
  <h2 class="mb-2 text-sm font-semibold tracking-widest uppercase" style="color: var(--color-brand);">// Tech Stack</h2>
  <p class="mb-10 text-sm" style="color: var(--text-muted);">
    Tecnologías con las que trabajo día a día.
  </p>

  <BlurFadeW client:load>
    <div id="skills-grid" class="grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));">
      {skills.map(skill => (
        <Skill skill={skill} />
      ))}
    </div>
  </BlurFadeW>
</section>
