---
import SocialMedias from "./SocialMedias.astro";
import IconSend from "./icons/IconSend.astro";
import BlurFadeW from "./ui/BlurFadeW";
---

<section id="contact" class="mx-auto max-w-5xl px-4 py-20">
  <h2 class="mb-2 text-sm font-semibold tracking-widest uppercase" style="color: var(--color-brand);" data-i18n="contact.heading">// Contacto</h2>
  <p class="mb-10 text-sm" style="color: var(--text-muted);" data-i18n="contact.subtitle">
    Construyamos algo juntos
  </p>

  <BlurFadeW client:load>
    <div class="grid gap-10 lg:grid-cols-12">
      <!-- Left: Info -->
      <div class="lg:col-span-5">
        <p class="text-lg font-semibold mb-4" style="color: var(--text-primary);" data-i18n="contact.connect">
          Conectemos
        </p>
        <p class="text-sm mb-6" style="color: var(--text-muted);" data-i18n="contact.description">
          Estoy disponible para oportunidades laborales, proyectos freelance o simplemente 
          para conectar con otros desarrolladores.
        </p>
        <SocialMedias />
      </div>

      <!-- Right: Form -->
      <div class="lg:col-span-7">
        <form
          id="contact-form"
          class="rounded-[2rem] p-8 md:p-12"
          style="background: var(--bg-secondary); border: 1px solid var(--border-color); backdrop-filter: blur(16px);"
        >
          <div class="space-y-5">
            <div>
              <label for="name" class="mb-1 block text-xs font-medium" style="color: var(--text-muted);"><span data-i18n="contact.form.name">Nombre</span></label>
              <input
                type="text" id="name" name="name" required
                class="w-full rounded-xl px-4 py-3 text-sm outline-none transition-all"
                style="background: var(--bg-primary); color: var(--text-primary); border: 1px solid var(--border-color);"
                placeholder="Tu nombre"
                data-i18n-placeholder="contact.form.placeholderName"
                pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$"
              />
              <p id="name-error" class="mt-1 text-xs hidden" style="color: var(--color-brand);"></p>
            </div>
            <div>
              <label for="email" class="mb-1 block text-xs font-medium" style="color: var(--text-muted);"><span data-i18n="contact.form.email">Email</span></label>
              <input
                type="email" id="email" name="email" required
                class="w-full rounded-xl px-4 py-3 text-sm outline-none transition-all"
                style="background: var(--bg-primary); color: var(--text-primary); border: 1px solid var(--border-color);"
                placeholder="tu@email.com"
                data-i18n-placeholder="contact.form.placeholderEmail"
              />
              <p id="email-error" class="mt-1 text-xs hidden" style="color: var(--color-brand);"></p>
            </div>
            <div>
              <label for="message" class="mb-1 block text-xs font-medium" style="color: var(--text-muted);"><span data-i18n="contact.form.message">Mensaje</span></label>
              <textarea
                id="message" name="message" required maxlength={500}
                class="w-full rounded-xl px-4 py-3 text-sm outline-none transition-all"
                style="background: var(--bg-primary); color: var(--text-primary); border: 1px solid var(--border-color); min-height: 120px; resize: vertical;"
                placeholder="Cuéntame sobre tu proyecto..."
                data-i18n-placeholder="contact.form.placeholderMessage"
              ></textarea>
              <p id="message-error" class="mt-1 text-xs hidden" style="color: var(--color-brand);"></p>
            </div>
            <!-- Honeypot -->
            <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />
            <button
              type="submit"
              class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold transition-all hover:opacity-85"
              style="background: var(--color-brand); color: #fff;"
            >
              <IconSend size={16} /> <span data-i18n="contact.form.send">Enviar mensaje</span>
            </button>
            <p id="form-status" class="mt-3 text-xs hidden" style="color: var(--color-cyan);"></p>
          </div>
        </form>
      </div>
    </div>
  </BlurFadeW>
</section>

<script>
  const form = document.getElementById('contact-form');
  const nameInput = document.getElementById('name');
  const emailInput = document.getElementById('email');
  const messageInput = document.getElementById('message');
  const nameError = document.getElementById('name-error');
  const emailError = document.getElementById('email-error');
  const messageError = document.getElementById('message-error');
  const formStatus = document.getElementById('form-status');

  const formI18n = {
    es: { nameRequired: 'El nombre es requerido', nameInvalid: 'Solo letras y espacios', emailRequired: 'El email es requerido', emailInvalid: 'Email inválido', messageRequired: 'El mensaje es requerido', messageMax: 'Máximo 500 caracteres', sending: 'Enviando...', success: '✓ Mensaje enviado con éxito. ¡Gracias!', error: 'Error al enviar. Intenta de nuevo.', connectionError: 'Error de conexión. Intenta de nuevo.' },
    en: { nameRequired: 'Name is required', nameInvalid: 'Only letters and spaces', emailRequired: 'Email is required', emailInvalid: 'Invalid email', messageRequired: 'Message is required', messageMax: 'Maximum 500 characters', sending: 'Sending...', success: '✓ Message sent successfully. Thanks!', error: 'Error sending. Try again.', connectionError: 'Connection error. Try again.' },
    de: { nameRequired: 'Name ist erforderlich', nameInvalid: 'Nur Buchstaben und Leerzeichen', emailRequired: 'E-Mail ist erforderlich', emailInvalid: 'Ungültige E-Mail', messageRequired: 'Nachricht ist erforderlich', messageMax: 'Maximal 500 Zeichen', sending: 'Senden...', success: '✓ Nachricht erfolgreich gesendet. Danke!', error: 'Fehler beim Senden. Versuche es erneut.', connectionError: 'Verbindungsfehler. Versuche es erneut.' },
  };
  function t(key) {
    const lang = localStorage.getItem('dhardi-lang') || 'es';
    return formI18n[lang]?.[key] || formI18n.es[key];
  }

  function validateName(v) {
    if (!v.trim()) return t('nameRequired');
    if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(v)) return t('nameInvalid');
    return '';
  }
  function validateEmail(v) {
    if (!v.trim()) return t('emailRequired');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return t('emailInvalid');
    return '';
  }
  function validateMessage(v) {
    if (!v.trim()) return t('messageRequired');
    if (v.length > 500) return t('messageMax');
    return '';
  }

  function showError(el, msg) {
    if (msg) {
      el.textContent = msg;
      el.classList.remove('hidden');
      el.previousElementSibling.style.borderColor = 'var(--color-brand)';
    } else {
      el.classList.add('hidden');
      el.previousElementSibling.style.borderColor = 'var(--border-color)';
    }
  }

  nameInput.addEventListener('input', () => showError(nameError, validateName(nameInput.value)));
  emailInput.addEventListener('input', () => showError(emailError, validateEmail(emailInput.value)));
  messageInput.addEventListener('input', () => showError(messageError, validateMessage(messageInput.value)));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nameErr = validateName(nameInput.value);
    const emailErr = validateEmail(emailInput.value);
    const msgErr = validateMessage(messageInput.value);
    showError(nameError, nameErr);
    showError(emailError, emailErr);
    showError(messageError, msgErr);
    if (nameErr || emailErr || msgErr) return;

    formStatus.classList.remove('hidden');
    formStatus.textContent = t('sending');
    formStatus.style.color = 'var(--text-muted)';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: nameInput.value.trim(),
          email: emailInput.value.trim(),
          message: messageInput.value.trim(),
        }),
      });
      if (res.ok) {
        formStatus.textContent = t('success');
        formStatus.style.color = '#33c08c';
        form.reset();
      } else {
        const data = await res.json();
        formStatus.textContent = data.error || t('error');
        formStatus.style.color = 'var(--color-brand)';
      }
    } catch {
      formStatus.textContent = t('connectionError');
      formStatus.style.color = 'var(--color-brand)';
    }
  });
</script>
