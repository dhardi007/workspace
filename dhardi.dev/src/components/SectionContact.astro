---
import SocialMedias from "./SocialMedias.astro";
import IconSend from "./icons/IconSend.astro";
import BlurFadeW from "./ui/BlurFadeW";
---

<section id="contact" class="mx-auto max-w-5xl px-4 py-20">
  <h2 class="mb-2 text-sm font-semibold tracking-widest uppercase" style="color: var(--color-brand);">// Contacto</h2>
  <p class="mb-10 text-sm" style="color: var(--text-muted);">
    ¿Tienes un proyecto en mente? Hablemos.
  </p>

  <BlurFadeW client:load>
    <div class="grid gap-10 lg:grid-cols-12">
      <!-- Left: Info -->
      <div class="lg:col-span-5">
        <p class="text-lg font-semibold mb-4" style="color: var(--text-primary);">
          Conectemos
        </p>
        <p class="text-sm mb-6" style="color: var(--text-muted);">
          Estoy disponible para oportunidades laborales, proyectos freelance o simplemente 
          para conectar con otros desarrolladores.
        </p>
        <SocialMedias />
      </div>

      <!-- Right: Form -->
      <div class="lg:col-span-7">
        <form
          id="contact-form"
          class="rounded-[2rem] p-8 md:p-12"
          style="background: var(--bg-secondary); border: 1px solid var(--border-color); backdrop-filter: blur(16px);"
        >
          <div class="space-y-5">
            <div>
              <label for="name" class="mb-1 block text-xs font-medium" style="color: var(--text-muted);">Nombre</label>
              <input
                type="text" id="name" name="name" required
                class="w-full rounded-xl px-4 py-3 text-sm outline-none transition-all"
                style="background: var(--bg-primary); color: var(--text-primary); border: 1px solid var(--border-color);"
                placeholder="Tu nombre"
                pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$"
              />
              <p id="name-error" class="mt-1 text-xs hidden" style="color: var(--color-brand);"></p>
            </div>
            <div>
              <label for="email" class="mb-1 block text-xs font-medium" style="color: var(--text-muted);">Email</label>
              <input
                type="email" id="email" name="email" required
                class="w-full rounded-xl px-4 py-3 text-sm outline-none transition-all"
                style="background: var(--bg-primary); color: var(--text-primary); border: 1px solid var(--border-color);"
                placeholder="tu@email.com"
              />
              <p id="email-error" class="mt-1 text-xs hidden" style="color: var(--color-brand);"></p>
            </div>
            <div>
              <label for="message" class="mb-1 block text-xs font-medium" style="color: var(--text-muted);">Mensaje</label>
              <textarea
                id="message" name="message" required maxlength={500}
                class="w-full rounded-xl px-4 py-3 text-sm outline-none transition-all"
                style="background: var(--bg-primary); color: var(--text-primary); border: 1px solid var(--border-color); min-height: 120px; resize: vertical;"
                placeholder="Cuéntame sobre tu proyecto..."
              ></textarea>
              <p id="message-error" class="mt-1 text-xs hidden" style="color: var(--color-brand);"></p>
            </div>
            <!-- Honeypot -->
            <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />
            <button
              type="submit"
              class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold transition-all hover:opacity-85"
              style="background: var(--color-brand); color: #fff;"
            >
              <IconSend size={16} /> Enviar mensaje
            </button>
            <p id="form-status" class="mt-3 text-xs hidden" style="color: var(--color-cyan);"></p>
          </div>
        </form>
      </div>
    </div>
  </BlurFadeW>
</section>

<script>
  const form = document.getElementById('contact-form');
  const nameInput = document.getElementById('name');
  const emailInput = document.getElementById('email');
  const messageInput = document.getElementById('message');
  const nameError = document.getElementById('name-error');
  const emailError = document.getElementById('email-error');
  const messageError = document.getElementById('message-error');
  const formStatus = document.getElementById('form-status');

  function validateName(v) {
    if (!v.trim()) return 'El nombre es requerido';
    if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(v)) return 'Solo letras y espacios';
    return '';
  }
  function validateEmail(v) {
    if (!v.trim()) return 'El email es requerido';
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return 'Email inválido';
    return '';
  }
  function validateMessage(v) {
    if (!v.trim()) return 'El mensaje es requerido';
    if (v.length > 500) return 'Máximo 500 caracteres';
    return '';
  }

  function showError(el, msg) {
    if (msg) {
      el.textContent = msg;
      el.classList.remove('hidden');
      el.previousElementSibling.style.borderColor = 'var(--color-brand)';
    } else {
      el.classList.add('hidden');
      el.previousElementSibling.style.borderColor = 'var(--border-color)';
    }
  }

  nameInput.addEventListener('input', () => showError(nameError, validateName(nameInput.value)));
  emailInput.addEventListener('input', () => showError(emailError, validateEmail(emailInput.value)));
  messageInput.addEventListener('input', () => showError(messageError, validateMessage(messageInput.value)));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nameErr = validateName(nameInput.value);
    const emailErr = validateEmail(emailInput.value);
    const msgErr = validateMessage(messageInput.value);
    showError(nameError, nameErr);
    showError(emailError, emailErr);
    showError(messageError, msgErr);
    if (nameErr || emailErr || msgErr) return;

    formStatus.classList.remove('hidden');
    formStatus.textContent = 'Enviando...';
    formStatus.style.color = 'var(--text-muted)';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: nameInput.value.trim(),
          email: emailInput.value.trim(),
          message: messageInput.value.trim(),
        }),
      });
      if (res.ok) {
        formStatus.textContent = '✓ Mensaje enviado con éxito. Gracias!';
        formStatus.style.color = '#33c08c';
        form.reset();
      } else {
        const data = await res.json();
        formStatus.textContent = data.error || 'Error al enviar. Intenta de nuevo.';
        formStatus.style.color = 'var(--color-brand)';
      }
    } catch {
      formStatus.textContent = 'Error de conexión. Intenta de nuevo.';
      formStatus.style.color = 'var(--color-brand)';
    }
  });
</script>
