---
import { iconMap } from "./icons/index";
import { hexToRgba, hexToBorder } from "../lib/color.ts";
import type { Skill } from "../lib/skills.ts";

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const Icon = iconMap[skill.icon] || null;
---

<div
  class="skill-card group relative cursor-pointer rounded-xl p-4 text-center transition-all duration-300 hover:scale-105 hover:shadow-lg"
  style="background: {hexToRgba(skill.color, 0.06)}; border: 1px solid {hexToBorder(skill.color)};"
>
  <div class="mb-2 flex justify-center">
    {Icon && <Icon size={32} />}
  </div>
  <span class="text-xs font-semibold" style="color: var(--text-primary);">{skill.name}</span>

  <!-- Tooltip on hover -->
  <div class="absolute left-1/2 top-0 z-[100] w-56 -translate-x-1/2 -translate-y-full rounded-xl p-3 text-left opacity-0 shadow-xl transition-all duration-300 group-hover:opacity-100 group-hover:-translate-y-[calc(100%+12px)]" style="background: var(--bg-secondary); border: 1px solid var(--border-color); pointer-events: none;">
    <p class="text-xs font-semibold mb-1" style="color: {skill.color};">{skill.name}</p>
    <p class="text-xs mb-2" style="color: var(--text-muted);">{skill.description}</p>
    <div class="flex flex-wrap gap-1">
      {skill.tags.slice(0, 3).map(tag => (
        <span class="rounded px-1.5 py-0.5 text-[10px]" style="background: {hexToRgba(skill.color, 0.1)}; color: {skill.color};">{tag}</span>
      ))}
    </div>
  </div>
</div>
