---
import { projects } from "../lib/projects.ts";
import Proyect from "./Proyect.astro";
import BlurFadeW from "./ui/BlurFadeW";

const featured = projects.filter(p => p.featured);
const rest = projects.filter(p => !p.featured);
---

<section id="projects" class="mx-auto max-w-5xl px-4 py-20">
  <h2 class="mb-2 text-sm font-semibold tracking-widest uppercase" style="color: var(--color-brand);">// Proyectos</h2>
  <p class="mb-10 text-sm" style="color: var(--text-muted);">
    Proyectos destacados y experimentos.
  </p>

  <BlurFadeW client:load>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map(p => <Proyect project={p} />)}
    </div>
  </BlurFadeW>

  {rest.length > 0 && (
    <>
      <h3 class="mt-12 mb-6 text-sm font-semibold" style="color: var(--text-muted);">Más proyectos</h3>
      <BlurFadeW delay={0.2} client:load>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map(p => <Proyect project={p} />)}
        </div>
      </BlurFadeW>
    </>
  )}
</section>
